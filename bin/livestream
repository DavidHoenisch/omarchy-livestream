#!/usr/bin/env bash
# Live stream a monitor to an RTMP(S) destination with gpu-screen-recorder.
#
#   livestream destinations          id<TAB>name<TAB>ready(0|1) per destination
#   livestream monitors              monitor names, focused first
#   livestream webcams               device<TAB>name per capture-capable webcam
#   livestream status                idle | live<TAB>dest<TAB>monitor<TAB>startEpoch | ended<TAB>reason
#   livestream mics                  source<TAB>name<TAB>default(0|1) per microphone
#   livestream audio                 desktop<TAB>on|off, mic<TAB>source|off (current stream)
#   livestream start <dest> <monitor> [fps] [kbps] [webcam|none] [small|medium|large]
#                    [desktop on|off] [mic source|default|off]
#   livestream desktop on|off        change desktop audio of the running stream
#   livestream mic <source>|off      switch or mute the microphone of the running stream
#   livestream stop
#
# Audio goes through a private null sink (omarchy_livestream): desktop audio
# and the microphone each feed it through their own loopback, and the stream
# records its monitor, so either can change without restarting the stream.
#   livestream keys-path             create the keys file if missing, print its path
#
# Stream keys live in ~/.config/omarchy/livestream/keys.json (mode 600).

set -uo pipefail

KEYS_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/livestream"
KEYS="$KEYS_DIR/keys.json"
STATE="${XDG_RUNTIME_DIR:-/tmp}/omarchy-livestream-$UID"
PID_FILE="$STATE/pid"
INFO_FILE="$STATE/info"
LOG_FILE="$STATE/log"
CAM_PID_FILE="$STATE/webcam-pid"
MIX=omarchy_livestream
MIX_MOD="$STATE/mix-module"
DESKTOP_MOD="$STATE/desktop-module"
MIC_MOD="$STATE/mic-module"
MIC_SRC="$STATE/mic-source"

die() { printf '%s\n' "$*" >&2; exit 1; }

ensure_keys() {
  if [[ -f $KEYS ]]; then chmod 600 "$KEYS"; return; fi
  mkdir -p "$KEYS_DIR"
  chmod 700 "$KEYS_DIR"
  (
    umask 077
    cat >"$KEYS" <<'EOF'
{
  "youtube": { "name": "YouTube", "url": "rtmp://a.rtmp.youtube.com/live2", "key": "" },
  "x": { "name": "X", "url": "", "key": "" },
  "twitch": { "name": "Twitch", "url": "rtmp://live.twitch.tv/app", "key": "" }
}
EOF
  )
}

ensure_state() {
  mkdir -p "$STATE"
  chmod 700 "$STATE"
}

running_pid() {
  [[ -f $PID_FILE ]] || return 1
  local pid
  pid=$(<"$PID_FILE")
  [[ $pid =~ ^[0-9]+$ ]] || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  [[ $(cat "/proc/$pid/comm" 2>/dev/null) == gpu-screen-rec* ]] || return 1
  printf '%s' "$pid"
}

# Last useful log line, with anything that looks like a URL removed so a
# stream key never leaves the private log.
last_error() {
  [[ -f $LOG_FILE ]] || return
  grep -v '^\s*$' "$LOG_FILE" | tail -n 1 | sed -E 's#rtmps?://[^ ]*#<url>#g' | cut -c1-200
}

cmd_destinations() {
  ensure_keys
  jq -r 'to_entries[]
    | select(.key | test("^[a-z0-9_-]{1,32}$"))
    | [.key,
       ((.value.name // .key) | tostring | gsub("[\t\n]"; " ") | .[0:40]),
       (if ((.value.url // "") | test("^rtmps?://")) and ((.value.key // "") | length > 0) then "1" else "0" end)]
    | @tsv' "$KEYS" 2>/dev/null || die "keys.json is not valid JSON"
}

cmd_monitors() {
  hyprctl monitors -j | jq -r 'sort_by(.focused | not) | .[].name'
}

cmd_webcams() {
  omarchy-capture-webcam-list | while read -r device name; do
    [[ $device =~ ^/dev/video[0-9]+$ ]] || continue
    name=${name%:}
    printf '%s\t%s\n' "$device" "${name%% (*}"
  done
}

# Omarchy's own webcam overlay (same mpv window and Hyprland rules that
# omarchy capture screenrecording uses), placed on the streamed monitor so the
# screen capture picks it up. SUPER+ALT+-/= resize it while live.
start_webcam() {
  local device=$1 size=$2 monitor=$3
  stop_webcam
  [[ -e $device ]] || die "Webcam $device not found"

  local opts="framerate=30" formats res
  formats=$(v4l2-ctl --list-formats-ext -d "$device" 2>/dev/null)
  for res in 640x360 1280x720 1920x1080; do
    if grep -q "$res" <<<"$formats"; then opts="video_size=$res,$opts"; break; fi
  done

  hyprctl dispatch "hl.dsp.focus({ monitor = \"$monitor\" })" >/dev/null 2>&1 ||
    hyprctl dispatch focusmonitor "$monitor" >/dev/null 2>&1

  setsid mpv "av://v4l2:$device" \
    --profile=low-latency --untimed --no-cache \
    --demuxer-lavf-o="$opts" \
    '--vf=lavfi=[crop=ih*8/9:ih]' \
    --title="WebcamOverlay" --wayland-app-id="WebcamOverlay-$size" \
    --no-border --no-audio --no-osc --osd-level=0 \
    --really-quiet </dev/null &>/dev/null &
  printf '%s' "$!" >"$CAM_PID_FILE"

  local i
  for i in $(seq 1 60); do
    hyprctl clients -j | jq -e 'any(.[]; .title == "WebcamOverlay")' >/dev/null 2>&1 && break
    sleep 0.05
  done
  omarchy-capture-webcam-resize "$size" 2>/dev/null
  sleep 0.4
}

stop_webcam() {
  [[ -f $CAM_PID_FILE ]] || return 0
  local pid
  pid=$(<"$CAM_PID_FILE")
  if [[ $pid =~ ^[0-9]+$ && $(cat "/proc/$pid/comm" 2>/dev/null) == mpv ]]; then
    kill "$pid" 2>/dev/null
  fi
  rm -f "$CAM_PID_FILE"
}

valid_source() {
  [[ $1 =~ ^[A-Za-z0-9_.:-]{1,200}$ && $1 != *.monitor && $1 != "$MIX"* ]] &&
    pactl list short sources 2>/dev/null | cut -f2 | grep -qxF "$1"
}

cmd_mics() {
  local default
  default=$(pactl get-default-source 2>/dev/null)
  pactl -f json list sources 2>/dev/null | jq -r --arg d "$default" --arg mix "$MIX" '
    .[] | select((.name | endswith(".monitor") | not) and (.name | startswith($mix) | not))
    | [.name,
       ((.description // .name) | sub(" (Analog Stereo|Analog Mono|Mono|Stereo)$"; "") | gsub("[\t\n]"; " ") | .[0:40]),
       (if .name == $d then "1" else "0" end)]
    | @tsv'
}

unload_mod() {
  local file=$1 id
  [[ -f $file ]] || return 0
  id=$(<"$file")
  [[ $id =~ ^[0-9]+$ ]] && pactl unload-module "$id" 2>/dev/null
  rm -f "$file"
}

loopback() {
  pactl load-module module-loopback source="$1" sink="$MIX" latency_msec=20 \
    source_dont_move=true sink_dont_move=true \
    sink_input_properties=media.name=omarchy-livestream 2>/dev/null
}

mix_up() {
  mix_down
  local before id
  before=$(pactl get-default-sink 2>/dev/null)
  id=$(pactl load-module module-null-sink sink_name="$MIX" \
    sink_properties=device.description=Live-Stream-Mix 2>/dev/null) || die "Could not create the audio mix"
  printf '%s' "$id" >"$MIX_MOD"
  # Never let the mix become the speakers.
  [[ -n $before && $(pactl get-default-sink 2>/dev/null) != "$before" ]] && pactl set-default-sink "$before"
}

mix_down() {
  unload_mod "$MIC_MOD"
  unload_mod "$DESKTOP_MOD"
  unload_mod "$MIX_MOD"
  rm -f "$MIC_SRC"
}

desktop_on() {
  [[ -f $DESKTOP_MOD ]] && return 0
  local sink id
  sink=$(pactl get-default-sink 2>/dev/null)
  [[ -n $sink && $sink != "$MIX" ]] || die "No desktop audio output found"
  id=$(loopback "$sink.monitor") || die "Could not add desktop audio"
  printf '%s' "$id" >"$DESKTOP_MOD"
}

mic_on() {
  local src=$1 id
  [[ $src == default ]] && src=$(pactl get-default-source 2>/dev/null)
  valid_source "$src" || die "Microphone not found"
  unload_mod "$MIC_MOD"
  id=$(loopback "$src") || die "Could not add microphone"
  printf '%s' "$id" >"$MIC_MOD"
  printf '%s' "$src" >"$MIC_SRC"
}

cmd_audio() {
  printf 'desktop\t%s\n' "$([[ -f $DESKTOP_MOD ]] && echo on || echo off)"
  printf 'mic\t%s\n' "$([[ -f $MIC_MOD && -f $MIC_SRC ]] && cat "$MIC_SRC" || echo off)"
}

cmd_desktop() {
  [[ -f $MIX_MOD ]] || die "Not live"
  case ${1:-} in
    on) desktop_on ;;
    off) unload_mod "$DESKTOP_MOD" ;;
    *) die "usage: livestream desktop on|off" ;;
  esac
}

cmd_mic() {
  [[ -f $MIX_MOD ]] || die "Not live"
  case ${1:-} in
    off) unload_mod "$MIC_MOD"; rm -f "$MIC_SRC" ;;
    "") die "usage: livestream mic <source>|off" ;;
    *) mic_on "$1" ;;
  esac
}

cmd_status() {
  if running_pid >/dev/null && [[ -f $INFO_FILE ]]; then
    printf 'live\t%s\n' "$(<"$INFO_FILE")"
  elif [[ -f $INFO_FILE ]]; then
    printf 'ended\t%s\n' "$(last_error)"
    stop_webcam
    mix_down
    rm -f "$INFO_FILE" "$PID_FILE"
  else
    echo idle
  fi
}

cmd_start() {
  local dest=${1:-} monitor=${2:-} fps=${3:-60} kbps=${4:-6000} webcam=${5:-none} size=${6:-medium} desktop=${7:-on} mic=${8:-default}
  [[ $desktop =~ ^(on|off)$ ]] || die "Invalid desktop audio choice"
  [[ $webcam == none || $webcam =~ ^/dev/video[0-9]+$ ]] || die "Invalid webcam"
  [[ $size =~ ^(small|medium|large)$ ]] || die "Invalid webcam size"
  [[ $dest =~ ^[a-z0-9_-]{1,32}$ ]] || die "Invalid destination"
  [[ $monitor =~ ^[A-Za-z0-9_.-]{1,64}$ ]] || die "Invalid monitor"
  [[ $fps =~ ^[0-9]+$ ]] && ((fps >= 10 && fps <= 120)) || die "Invalid fps"
  [[ $kbps =~ ^[0-9]+$ ]] && ((kbps >= 500 && kbps <= 50000)) || die "Invalid bitrate"
  running_pid >/dev/null && die "Already live"
  command -v gpu-screen-recorder >/dev/null || die "gpu-screen-recorder is not installed"

  ensure_keys
  local url key
  url=$(jq -r --arg d "$dest" '.[$d].url // ""' "$KEYS") || die "keys.json is not valid JSON"
  key=$(jq -r --arg d "$dest" '.[$d].key // ""' "$KEYS")
  [[ $url =~ ^rtmps?://[^[:space:]]+$ ]] || die "No RTMP URL set for $dest in keys.json"
  [[ -n $key && ! $key =~ [[:space:]] ]] || die "No stream key set for $dest in keys.json"

  ensure_state
  : >"$LOG_FILE"
  chmod 600 "$LOG_FILE"

  # Any failure from here on tears down what was set up.
  trap 'stop_webcam; mix_down' EXIT
  mix_up
  [[ $desktop == on ]] && desktop_on
  [[ $mic != off ]] && mic_on "$mic"

  # Open the camera first so the stream doesn't show it sliding into place.
  [[ $webcam != none ]] && start_webcam "$webcam" "$size" "$monitor"

  setsid gpu-screen-recorder \
    -w "$monitor" -c flv -k h264 -f "$fps" -fm cfr \
    -bm cbr -q "$kbps" -keyint 2 \
    -a "$MIX.monitor" -ac aac -ab 160 \
    -fallback-cpu-encoding yes \
    -o "${url%/}/$key" \
    </dev/null >>"$LOG_FILE" 2>&1 &
  local pid=$!
  printf '%s' "$pid" >"$PID_FILE"
  printf '%s\t%s\t%s' "$dest" "$monitor" "$(date +%s)" >"$INFO_FILE"

  # Fail fast on a bad key/URL or capture error.
  local i
  for i in 1 2 3 4 5 6; do
    sleep 0.5
    if ! kill -0 "$pid" 2>/dev/null; then
      local reason
      reason=$(last_error)
      rm -f "$INFO_FILE" "$PID_FILE"
      stop_webcam
      mix_down
      die "Stream failed to start${reason:+: $reason}"
    fi
  done
  trap - EXIT
}

cmd_stop() {
  local pid
  pid=$(running_pid) || { rm -f "$INFO_FILE" "$PID_FILE"; stop_webcam; mix_down; return 0; }
  kill -INT "$pid" 2>/dev/null
  local i
  for i in $(seq 1 50); do
    kill -0 "$pid" 2>/dev/null || break
    sleep 0.1
  done
  kill -0 "$pid" 2>/dev/null && kill -TERM "$pid" 2>/dev/null
  stop_webcam
  mix_down
  rm -f "$INFO_FILE" "$PID_FILE"
}

case "${1:-}" in
  destinations) cmd_destinations ;;
  monitors) cmd_monitors ;;
  webcams) cmd_webcams ;;
  mics) cmd_mics ;;
  audio) cmd_audio ;;
  desktop) shift; cmd_desktop "$@" ;;
  mic) shift; cmd_mic "$@" ;;
  status) cmd_status ;;
  start) shift; cmd_start "$@" ;;
  stop) cmd_stop ;;
  keys-path) ensure_keys; printf '%s\n' "$KEYS" ;;
  *) die "usage: livestream destinations|monitors|status|start <dest> <monitor> [fps] [kbps] [webcam|none] [size] [on|off] [mic|default|off]|desktop on|off|mic <source>|off|mics|audio|stop|keys-path" ;;
esac
